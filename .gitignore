__pycache__/
*.pyc

# 사내 CA 인증서(Dockerfile 빌드용) - 사내 자산이므로 커밋하지 않는다.
certs/*.crt
certs/*.pem

# 로컬 메일 API 자격증명
.env

# 웹 UI 수신자 태그 목록(이름/이메일 개인정보) - contacts.example.json 참고
contacts.json

# 안건 페이지 생성 시 지난번에 쓴 상위 페이지 URL(사내 Confluence 주소라
