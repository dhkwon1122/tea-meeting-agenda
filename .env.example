# ---- 이메일로 안건 요약 보내기 (선택) ----
# 사내 메일 발송 REST API(openapi.samsung.net)를 쓴다 - SMTP가 아니다.
# 아래 셋(TOKEN/SYSTEM_ID/USER_ID) 중 하나라도 비워두면, CLI 실행 시 메일
# 발송 질문 자체가 나오지 않거나(--to 없이 실행), --to를 명시했을 때는
# 설정 누락 오류를 내며 종료한다. 자세한 내용은 confluence_agenda/mailer.py 참고.

# 발급받은 API 접근 토큰. Authorization: Bearer <token> 헤더로 보낸다.
MAIL_API_TOKEN=
# System-ID 헤더 값 (API 발급 시 함께 받는 계정/시스템 식별자).
MAIL_API_SYSTEM_ID=
# 발송 요청자의 사용자 ID (요청 쿼리스트링 userId로 보낸다).
MAIL_API_USER_ID=
# 메일의 발신자 주소(sender.emailAddress). 비워두면 MAIL_API_USER_ID를 그대로 쓴다.
# MAIL_API_SENDER_ADDRESS=
# API base URL. 보통 바꿀 일 없음 (기본값 https://openapi.samsung.net/mail/api/v2.0).
# MAIL_API_BASE_URL=

# 메일 API 호출에서 "502 Bad Gateway"가 나고, 사내 프록시(HTTP_PROXY/
# HTTPS_PROXY)가 이 API를 제대로 못 넘기는 게 원인으로 의심되면 켤 것.
# MAIL_API_NO_PROXY=true

# 메일 API 서버가 자체 서명(self-signed) 인증서를 쓰는 등 TLS 검증이
# 실패하는 경우에만 끌 것. 신뢰할 수 있는 사내망 안에서만 사용할 것.
# MAIL_API_VERIFY_SSL=false

# ---- 로그인 (선택) ----
# dhkwon1122/Researcher-board와 같은 Postgres의 app_users 테이블을 그대로
# 읽기 전용으로 써서 로그인한다 - 계정 생성/삭제/비밀번호 변경은 이 앱에서
# 하지 않고 전부 Researcher-board 쪽 관리자 화면에서 한다. 비워두면 로그인
# 기능 자체가 꺼지고 기존처럼 로그인 없이 그대로 동작한다.
#
# Researcher-board와 반드시 "같은" DB를 가리켜야 같은 계정으로 로그인된다.
#
# 이 앱을 Docker로 띄운다면 호스트를 "localhost"로 쓰면 안 된다 - 컨테이너
# 안에서 localhost는 그 컨테이너 자기 자신이라 DB에 연결이 안 되고
# "Connection refused"가 난다(python -m confluence_agenda.web.auth_check로
# 보이는 가장 흔한 오류). 대신:
#
#   (a) Postgres가 호스트(워크스테이션)에 떠 있는 경우 → host.docker.internal 사용
#       예) DATABASE_URL=postgresql+psycopg2://postgres:postgres@host.docker.internal:5433/researcher_board
#       (docker-compose.yml에 extra_hosts로 이미 처리돼 있음. 단, Researcher-board의
#       번들 DB(--profile bundled-db)처럼 Postgres가 호스트의 127.0.0.1에만
#       바인딩돼 있으면 host.docker.internal로도 안 닿을 수 있다 - 그 경우 (b)로.)
#
#   (b) Researcher-board를 같은 docker compose로 띄웠다면(컨테이너 이름 db) →
#       두 프로젝트를 같은 Docker 네트워크에 묶고 서비스명을 쓴다
#       예) DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/researcher_board
#       (docker network ls로 Researcher-board 쪽 네트워크 이름을 확인한 뒤,
#       이 앱의 docker-compose.yml에 그 네트워크를 external로 추가해야 한다.)
#
#   (c) 이 앱을 Docker 없이 워크스테이션에서 직접 실행한다면(python -m
#       confluence_agenda.web) → Postgres가 호스트에 떠 있을 때 그냥
#       localhost를 쓰면 된다(컨테이너가 아니므로 문제없음).
#
# DATABASE_URL=

# 로그인 세션 쿠키 서명 키. DATABASE_URL을 설정했다면 필수(없으면 기동
# 자체가 실패한다). 생성 예:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# 로그인 세션 유지 시간(시간 단위), 기본 8.
# SESSION_LIFETIME_HOURS=8

# ---- 컨플루언스 문서 → Word 변환 (선택) ----
# wcoffee77/document-parsing(doc2report)를 그대로 가져와 쓴다 - 아래 둘 중
# 하나라도 비워두면 화면에 이 카드 자체가 안 보이고 기존처럼 동작한다.
# 자세한 설정 가이드(Cloud/Server-DC 판별, PAT 발급 등)는 그 저장소의
# docs/confluence-first-run.md 참고.

# REST API 엔드포인트의 기본 주소. 브라우저로 보는 위키 주소와 다른
# 서브도메인(REST 전용 게이트웨이)일 수 있다 - 둘 중 뭘 넣어도 되게
# 코드가 끝의 "/rest/api"는 있으면 떼고 쓴다.
# 예) CONFLUENCE_URL=https://wiki.사내주소 또는 http://api.confluence.사내주소/rest/api
# CONFLUENCE_URL=

# Cloud면 계정 이메일을 채운다(Basic 인증으로 전환됨). Server/Data Center면
# 절대 채우지 말 것 - 값이 있으면 Cloud로 오인해 인증이 깨진다.
# CONFLUENCE_USERNAME=

# API 토큰(Cloud) 또는 Personal Access Token(Server/DC, USERNAME 없이 Bearer로 씀).
#
# 팀 전체가 공용으로 쓸 토큰이면 여기(.env)에 넣는다. 하지만 각자 자기 권한으로
# Confluence에 접근해야 한다면(사용자마다 볼 수 있는 페이지가 다름) 이 값은
# 비워두고, 아래 CREDENTIAL_ENCRYPTION_KEY를 설정해서 로그인한 사용자가 화면에서
# 직접 자기 PAT을 등록하게 하는 쪽을 권장한다 - 그 경우 로그인한 사용자는 자신의
# 등록 PAT을 우선 쓰고(없으면 여기 공용 토큰으로 fallback), 로그인하지 않은
# 상태(DATABASE_URL 미설정)에서는 이 공용 토큰만 쓴다.
# CONFLUENCE_API_TOKEN=

# 사내 프록시가 자체 발급 인증서로 HTTPS를 중계해 "SSL 인증서 검증 실패"가
# 나면, 사내 루트 인증서(.crt/.pem) 경로를 지정할 것(REQUESTS_CA_BUNDLE/
# SSL_CERT_FILE도 같이 봐 준다).
# CONFLUENCE_CA_BUNDLE=

# httpx가 403이나 SSL 오류로 계속 막히면(Windows 사내망에서 보고된 패턴),
# 처음부터 PowerShell(Invoke-WebRequest)만 쓰게 강제한다.
# DOC2REPORT_CONFLUENCE_TRANSPORT=powershell

# 로그인한 사용자별로 자기 Confluence PAT을 화면에서 등록해 DB(위 DATABASE_URL과
# 같은 DB)에 암호화 저장하게 하려면 설정한다. DATABASE_URL이 없으면(= 로그인
# 기능 자체가 꺼져 있으면) 이 값이 있어도 소용없고, 위 CONFLUENCE_API_TOKEN
# 공용 토큰만 쓰인다. 생성 예:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 이 키를 잃어버리거나 바꾸면 이미 저장된 PAT은 복호화할 수 없게 되니(다시
# 등록해야 함) 안전한 곳(비밀관리 시스템 등)에 따로 보관해둘 것.
# CREDENTIAL_ENCRYPTION_KEY=
